PORT=3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# AI: any OpenAI-compatible API. Example for a free Google Gemini key (from aistudio.google.com/apikey):
#   MODEL_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   MODEL_NAME=gemini-2.5-flash-lite   (check the model list in AI Studio; names change)
#   MODEL_INPUT_USD_PER_MILLION=0 and MODEL_OUTPUT_USD_PER_MILLION=0 (free tier)
#   MODEL_MIN_INTERVAL_MS=6000 (free tier allows only a few requests per minute)
MODEL_API_KEY=
MODEL_API_BASE_URL=
MODEL_NAME=
MODEL_INPUT_USD_PER_MILLION=1.25
MODEL_OUTPUT_USD_PER_MILLION=4.25
# Wait at least this long between AI requests (milliseconds). 0 = no wait.
MODEL_MIN_INTERVAL_MS=0
# Longest AI answer in tokens. Raise it if the app says the answer was cut off.
MODEL_MAX_TOKENS=4000
# Optional: true asks the API for strict JSON output; reasoning effort such as none/low for thinking models.
MODEL_JSON_MODE=false
MODEL_REASONING_EFFORT=
# Only enable after accepting the unofficial Zalo connection's account risk.
ZALO_ENABLED=false
# Messages read per group at the morning scan (Zalo returns only the newest ones).
ZALO_HISTORY_COUNT=200
# Optional location for local private SQLite/session files.
DATA_DIR=data
# DiscordChatExporter CLI executable, downloaded from its official GitHub releases.
DISCORD_EXPORTER_PATH=
# Private account token: keep local, never paste into chat or commit.
DISCORD_TOKEN=
